{
  "name": "lubbdubb",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Self-hosted orchestration harness — a cockpit that watches your work inputs, decides what to do, and dispatches AI agents autonomously.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "build": "node --import tsx scripts/tsc.ts -p tsconfig.json",
    "dev": "node --import tsx --watch src/server/main.ts",
    "start": "npm run web:build && node --import tsx src/server/main.ts",
    "start:server": "node --import tsx src/server/main.ts",
    "serve": "npm run web:build && node --import tsx scripts/serve.ts",
    "serve:server": "node --import tsx scripts/serve.ts",
    "test:build": "node --import tsx scripts/testBuild.ts",
    "test": "npm run --silent test:build && node --enable-source-maps --test .testbuild/test/*.test.js",
    "test:coverage": "npm run --silent test:build && c8 --config .c8rc.json node --enable-source-maps --test .testbuild/test/*.test.js",
    "smoke": "node --import tsx scripts/smoke.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite --config web/vite.config.ts build",
    "web:build:demo": "vite --config web/vite.config.ts build --mode demo --base=/LubbDubb/",
    "typecheck": "node --import tsx scripts/tsc.ts -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/server.tsbuildinfo",
    "typecheck:web": "node --import tsx scripts/tsc.ts -p web/tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/web.tsbuildinfo",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"web/**/*.{ts,tsx}\" \"scripts/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --cache --check \"src/**/*.ts\" \"test/**/*.ts\" \"web/**/*.{ts,tsx}\" \"scripts/*.ts\" \"*.{json,md}\"",
    "knip": "knip --cache",
    "audit": "node --import tsx scripts/audit.ts",
    "audit:all": "node --import tsx scripts/audit.ts --all",
    "check": "node --import tsx scripts/check.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "nanoid": "^5.1.16",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild": true,
    "node-pty": true
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
