{
  "name": "lubbdubb",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted orchestration harness — a cockpit that watches your work inputs, decides what to do, and dispatches AI agents autonomously.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx --watch src/server/main.ts",
    "start": "npm run web:build && node --import tsx src/server/main.ts",
    "start:server": "node --import tsx src/server/main.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:coverage": "c8 --config .c8rc.json node --import tsx --test test/**/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:dev:demo": "vite --config web/vite.config.ts --mode demo",
    "web:build": "vite --config web/vite.config.ts build",
    "web:build:demo": "vite --config web/vite.config.ts build --mode demo --base=/LubbDubb/",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/server.tsbuildinfo",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/web.tsbuildinfo",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"web/**/*.{ts,tsx}\" \"scripts/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --cache --check \"src/**/*.ts\" \"test/**/*.ts\" \"web/**/*.{ts,tsx}\" \"scripts/*.ts\" \"*.{json,md}\"",
    "knip": "knip --cache",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "check": "node --import tsx scripts/check.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.10.0",
    "nanoid": "^5.0.7",
    "node-pty": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "c8": "^12.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "knip": "5.42.2",
    "prettier": "3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
