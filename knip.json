{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/server/main.ts", "test/**/*.test.ts", "scripts/*.ts", "web/src/main.tsx"],
  "project": ["src/**/*.ts", "web/src/**/*.{ts,tsx}", "scripts/*.ts"],
  "ignore": [],
  "ignoreDependencies": ["claude-code"],
  "ignoreBinaries": [],
  "vite": {
    "config": ["web/vite.config.ts"]
  },
  "includeEntryExports": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "duplicates": "error",
    "enumMembers": "error"
  }
}
